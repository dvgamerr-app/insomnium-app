{
  "name": "insomnium",
  "version": "0.1.0",
  "description": "Local-first API client built with Tauri and Svelte",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "type": "module",
  "scripts": {
    "dev": "bun x --bun vite dev",
    "build": "bun x --bun vite build",
    "preview": "bun x --bun vite preview",
    "prepare": "bun run generate:openapi && bun x --bun svelte-kit sync",
    "check": "bun x --bun svelte-kit sync && bun x --bun svelte-check --tsconfig ./jsconfig.json --config ./svelte.config.js --fail-on-warnings",
    "check:watch": "bun run check --watch",
    "tauri": "bun x --bun tauri",
    "desktop": "bun run tauri dev",
    "desktop:build": "bun run tauri build",
    "native:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "generate:openapi": "bun scripts/build-openapi-validators.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@noble/hashes": "^2.4.0",
    "@scalar/openapi-parser": "^0.29.5",
    "@scalar/openapi-validator": "^0.1.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-window-state": "~2",
    "@xmldom/xmldom": "0.9.12",
    "buffer": "6.0.3",
    "codemirror": "5.65.21",
    "codemirror-graphql": "^2.2.9",
    "date-fns": "2.30.0",
    "graphql": "16",
    "jsonpath-plus": "11.1.0",
    "nunjucks": "3.2.4",
    "openapi-sampler": "^1.7.6",
    "quickjs-emscripten-core": "0.32.0",
    "url": "0.11.4",
    "uuid": "9.0.1",
    "vkbeautify": "0.99.3",
    "xpath": "0.0.34",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.2",
    "@types/codemirror": "^5.60.18",
    "@types/vkbeautify": "^0.99.4",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
