{
  "name": "insomnium",
  "version": "0.1.0",
  "description": "Local-first API client built with Tauri and Svelte",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "type": "module",
  "scripts": {
    "dev": "bun x --bun vite dev",
    "build": "bun x --bun vite build",
    "preview": "bun x --bun vite preview",
    "prepare": "bun run generate:openapi && bun x --bun svelte-kit sync",
    "check": "bun x --bun svelte-kit sync && bun x --bun svelte-check --tsconfig ./jsconfig.json --config ./svelte.config.js --fail-on-warnings",
    "check:watch": "bun run check --watch",
    "tauri": "bun x --bun tauri",
    "desktop": "bun run tauri dev",
    "desktop:build": "bun scripts/build-desktop.mjs",
    "native:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "generate:openapi": "bun scripts/build-openapi-validators.mjs",
    "test:ui:git-create": "bun tests/ui/git-create-and-switch.js",
    "test:ui:git-resume": "bun tests/ui/git-create-resume.js",
    "test:ui:git-forget": "bun tests/ui/git-create-forget.js",
    "test:ui:git-delete": "bun tests/ui/git-delete-branch.js",
    "test:ui:git-delete-unmerged": "bun tests/ui/git-delete-unmerged.js",
    "test:ui:git-delete-stale": "bun tests/ui/git-delete-stale-session.js",
    "test:ui:git-remote": "bun tests/ui/git-remote-lifecycle.js",
    "test:ui:git-remote-settings": "bun tests/ui/git-remote-settings.js",
    "test:ui:git-fetch": "bun tests/ui/git-fetch.js",
    "test:ui:git-fetch-retire-race": "bun tests/ui/git-fetch-retire-race.js",
    "test:ui:git-fetch-recovery-errors": "bun tests/ui/git-fetch-recovery-errors.js",
    "test:ui:git-fetch-cleanup": "bun tests/ui/git-fetch-cleanup.js",
    "test:ui:git-fetch-parent-crash": "bun tests/ui/git-fetch-parent-crash.js",
    "test:ui:git-fetch-scope": "bun tests/ui/git-fetch-scope.js",
    "test:ui:graphql-editor": "bun tests/ui/graphql-editor.js",
    "test:ui:graphql-schema": "bun tests/ui/graphql-schema-lifecycle.js",
    "test:ui:graphql-context": "bun tests/ui/graphql-schema-context.js",
    "test:ui:graphql-execution": "bun tests/ui/graphql-execution.js",
    "test:ui:graphql-import": "bun tests/ui/graphql-schema-import.js",
    "test:ui:graphql-cache": "bun tests/ui/graphql-schema-cache.js",
    "test:ui:graphql-close": "bun tests/ui/graphql-schema-close.js",
    "test:ui:theme": "bun tests/ui/nocturne-theme.js",
    "test:ui:workspace": "bun tests/ui/nocturne-workspace.js",
    "test:ui:window-controls": "bun tests/ui/window-controls.js",
    "test:ui:source-control": "bun tests/ui/git-source-control.js"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@lucide/svelte": "^1.52.0",
    "@noble/hashes": "^2.4.0",
    "@scalar/openapi-parser": "^0.29.7",
    "@scalar/openapi-validator": "^0.1.6",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-fs": "~2",
    "@xmldom/xmldom": "0.9.12",
    "chai": "4.5.0",
    "codemirror": "5.65.21",
    "codemirror-graphql": "^2.2.9",
    "date-fns": "4.4.0",
    "diff": "9.0.0",
    "graphql": "16",
    "jsonpath-plus": "11.1.0",
    "mocha": "10.8.2",
    "nunjucks": "3.2.4",
    "openapi-sampler": "^1.7.6",
    "quickjs-emscripten-core": "0.32.0",
    "url": "0.11.4",
    "uuid": "14.0.2",
    "xpath": "0.0.34",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/bun": "^1.4.2",
    "@types/codemirror": "^5.60.18",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.1"
  }
}
