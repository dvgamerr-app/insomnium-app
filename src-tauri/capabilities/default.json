{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "allow-send-http",
    "allow-cancel-http",
    "allow-fetch-oauth-token",
    "allow-authorize-oauth",
    "allow-submit-oauth-callback",
    "allow-connect-stream",
    "allow-send-stream-message",
    "allow-acknowledge-stream",
    "allow-load-grpc-schema",
    "allow-connect-grpc",
    "allow-send-grpc-message",
    "allow-acknowledge-grpc",
    "allow-list-cookies",
    "allow-change-cookie",
    "allow-import-legacy-cookies",
    "allow-load-workspace",
    "allow-save-workspace",
    "core:default",
    "opener:default",
    "core:window:allow-destroy",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "allow-read-template-file",
    "allow-read-template-cookie",
    "allow-read-template-os"
  ]
}
