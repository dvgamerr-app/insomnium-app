{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-reserve-spectral-lint",
    "allow-run-spectral-lint",
    "allow-cancel-spectral-lint",
    "allow-begin-plugin-event-transport",
    "allow-end-plugin-event-transport",
    "allow-begin-plugin-clipboard-probe",
    "allow-write-plugin-clipboard-probe",
    "allow-get-plugin-clipboard-probe",
    "allow-end-plugin-clipboard-probe",
    "allow-write-clipboard-text",
    "allow-send-http",
    "allow-read-openapi-files",
    "allow-response-download",
    "allow-cancel-http",
    "allow-fetch-oauth-token",
    "allow-authorize-oauth",
    "allow-submit-oauth-callback",
    "allow-connect-stream",
    "allow-send-stream-message",
    "allow-acknowledge-stream",
    "allow-load-grpc-schema",
    "allow-connect-grpc",
    "allow-send-grpc-message",
    "allow-acknowledge-grpc",
    "allow-list-cookies",
    "allow-snapshot-request-cookies",
    "allow-change-cookie",
    "allow-import-legacy-cookies",
    "allow-load-workspace",
    "allow-save-workspace",
    "allow-inspect-workspace-backup",
    "allow-restore-workspace-backup",
    "allow-read-legacy-response-assets",
    "allow-read-legacy-request-assets",
    "allow-read-legacy-certificate-assets",
    "allow-discover-plugins",
    "allow-discover-plugin-sources",
    "allow-read-plugin-package",
    "allow-reserve-plugin-inspection",
    "allow-run-plugin-inspection",
    "allow-cancel-plugin-inspection",
    "allow-open-bun-plugin-session",
    "allow-invoke-bun-plugin-callback",
    "allow-reply-bun-plugin-helper",
    "allow-set-bun-plugin-interaction",
    "allow-plugin-store",
    "allow-import-legacy-plugin-data",
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "dialog:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-clear",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-stat",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-fstat",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "allow-read-template-file",
    "allow-read-template-cookie",
    "allow-read-template-os",
    "allow-reserve-plugin-save",
    "allow-show-plugin-save",
    "allow-cancel-plugin-save",
    "allow-git-repository-init",
    "allow-git-repository-info",
    "allow-git-repository-read-commit",
    "allow-git-repository-prepare-merge",
    "allow-git-repository-history",
    "allow-git-repository-commit",
    "allow-git-repository-create-branch",
    "allow-git-repository-create-remote-branch",
    "allow-git-repository-checkout",
    "allow-git-repository-advance",
    "allow-git-repository-apply-merge",
    "allow-git-repository-restore",
    "allow-git-repository-delete-branch",
    "allow-git-remote-advertise",
    "allow-git-clone-stage",
    "allow-git-clone-inspect",
    "allow-git-clone-list",
    "allow-git-clone-install",
    "allow-git-remote-cancel",
    "allow-git-remote-fetch",
    "allow-git-remote-push",
    "allow-git-remote-push-inspect",
    "allow-git-remote-push-retire",
    "allow-git-remote-fetch-inspect",
    "allow-git-remote-fetch-recovery-status",
    "allow-git-remote-fetch-recover",
    "allow-git-remote-cleanup-staging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        }
      ]
    }
  ]
}
