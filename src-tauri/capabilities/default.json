{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "allow-send-http",
    "allow-cancel-http",
    "allow-fetch-oauth-token",
    "allow-authorize-oauth",
    "allow-submit-oauth-callback",
    "allow-connect-stream",
    "allow-send-stream-message",
    "allow-acknowledge-stream",
    "allow-load-grpc-schema",
    "allow-connect-grpc",
    "allow-send-grpc-message",
    "allow-acknowledge-grpc",
    "allow-list-cookies",
    "allow-snapshot-request-cookies",
    "allow-change-cookie",
    "allow-import-legacy-cookies",
    "allow-load-workspace",
    "allow-save-workspace",
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "allow-read-template-file",
    "allow-read-template-cookie",
    "allow-read-template-os",
    "allow-git-repository-init",
    "allow-git-repository-info",
    "allow-git-repository-read-commit",
    "allow-git-repository-prepare-merge",
    "allow-git-repository-history",
    "allow-git-repository-commit",
    "allow-git-repository-create-branch",
    "allow-git-repository-create-remote-branch",
    "allow-git-repository-checkout",
    "allow-git-repository-advance",
    "allow-git-repository-apply-merge",
    "allow-git-repository-restore",
    "allow-git-repository-delete-branch",
    "allow-git-remote-advertise",
    "allow-git-clone-stage",
    "allow-git-clone-inspect",
    "allow-git-clone-list",
    "allow-git-clone-install",
    "allow-git-remote-cancel",
    "allow-git-remote-fetch",
    "allow-git-remote-fetch-inspect",
    "allow-git-remote-fetch-recovery-status",
    "allow-git-remote-fetch-recover",
    "allow-git-remote-cleanup-staging"
  ]
}
